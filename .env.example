# Application
APP_PORT=3000
APP_HOST=0.0.0.0
APP_ENV=stag

# External JWT validation
JWT_SECRET=change-me
JWT_ISSUER=workshop-edge
JWT_AUDIENCE=workshop-app

# Legacy local credentials are retained for dependency wiring only.
ADMIN_USERNAME=disabled
ADMIN_PASSWORD=disabled

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=workshop_user
POSTGRES_PASSWORD=workshop_password
POSTGRES_DB=workshop_db

# Test PostgreSQL (used only by automated tests)
# These variables define a separate logical database for test runs.
# Implementation will select this DB during tests without affecting runtime.
POSTGRES_DB_TEST=workshop_db_test

# BEECEPTOR Notification URL
BEECEPTOR_NOTIFICATION_URL=https://something.free.beeceptor.com

# RabbitMQ messaging foundation (optional; empty URL disables live broker startup)
RABBITMQ_URL=
RABBITMQ_EXCHANGE=workshop.os.events
RABBITMQ_WORK_ORDER_EVENTS_QUEUE=workshop.os.work-order-events
RABBITMQ_SAGA_EVENTS_QUEUE=workshop.os.saga-events
RABBITMQ_CONSUMERS_ENABLED=false

# OpenTelemetry / Datadog
OTEL_SERVICE_NAME=workshop-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://datadog-agent:4318
DD_SERVICE=workshop-app
DD_ENV=stag
DD_VERSION=local

# Optional: override database URL (will take precedence if set)
# DATABASE_URL=postgresql://workshop_user:workshop_password@postgres:5432/workshop_db

# Optional: override test database URL (takes precedence for test runs)
# DATABASE_URL_TEST=postgresql://workshop_user:workshop_password@postgres:5432/workshop_db_test
