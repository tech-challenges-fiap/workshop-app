{
  "name": "workshop-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "start:prod": "bun run dist/src/main.js",
    "health": "curl -f http://localhost:3000/health || exit 1",
    "build": "tsc -p tsconfig.build.json",
    "arch:check": "bun run scripts/architecture-gate.ts check",
    "arch:graph": "bun run scripts/architecture-gate.ts graph",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,docs}/**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"{src,docs}/**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "db:migrate": "bun run src/infrastructure/db/migrate.ts",
    "db:seed": "bun run src/infrastructure/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.207.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.207.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.207.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "dependency-cruiser": "^17.3.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.4"
  }
}
